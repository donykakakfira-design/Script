-- AUTO PICK EGG
local function IsEgg(obj)
    local name = obj.Name:lower()

    return name:find("egg") ~= nil
        or name:find("telur") ~= nil
end

local function CollectEggs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if not State.Running or not State.AutoEgg then
            break
        end

        if IsEgg(obj) then
            -- ProximityPrompt
            if obj:IsA("ProximityPrompt") then
                pcall(function()
                    fireproximityprompt(obj)
                end)
            end

            -- ClickDetector
            if obj:IsA("ClickDetector") then
                pcall(function()
                    fireclickdetector(obj)
                end)
            end

            -- Egg touch collection
            if obj:IsA("BasePart") then
                local root = Root()

                if root and (root.Position - obj.Position).Magnitude < 100 then
                    pcall(function()
                        firetouchinterest(root, obj, 0)
                        task.wait(0.1)
                        firetouchinterest(root, obj, 1)
                    end)
                end
            end
        end
    end
end

task.spawn(function()
    while State.Running do
        if State.AutoEgg then
            CollectEggs()
        end

        task.wait(1)
    end
end)

