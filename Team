local function Toggle(name, y, key)
    local b
    local function update()
        b.Text = name .. " : " ..
            (State[key] and "ON" or "OFF")
        b.BackgroundColor3 = State[key]
            and Color3.fromRGB(25, 130, 75)
            or Color3.fromRGB(65, 65, 80)
    end

    b = Button("", y, function()
        State[key] = not State[key]
        update()
    end)

    update()
    return b
end

-- ISLAND DETECTION
local Islands = {}

local function ScanIslands()
    table.clear(Islands)

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local name = obj.Name:lower()

            if name:find("island")
            or name:find("pulau")
            or name:find("zone")
            or name:find("world")
            or name:find("area") then

                if obj:FindFirstChildWhichIsA("BasePart", true) then
                    table.insert(Islands, obj)
                end
            end
        end
    end

    table.sort(Islands, function(a, b)
        return a.Name < b.Name
    end)

    State.IslandIndex = math.clamp(
        State.IslandIndex, 1, math.max(1, #Islands)
    )

    return #Islands
end

local islandLabel = Label("Island: scanning...", 48, 24)

local function TeleportIsland()
    if #Islands == 0 then
        ScanIslands()
    end

    local island = Islands[State.IslandIndex]
    local root = Root()

    if not island or not root then return end

    local success, cf = pcall(function()
        return island:GetPivot()
    end)

    if success then
        root.CFrame = cf + Vector3.new(0, 5, 0)
        islandLabel.Text = "Island: " .. island.Name
    end
end

Button("SCAN ISLANDS", 76, function()
    local count = ScanIslands()
    islandLabel.Text = "Found Islands: " .. count
end)

Button("TELEPORT NEXT ISLAND", 112, function()
    if #Islands == 0 then ScanIslands() end

    if #Islands > 0 then
        State.IslandIndex = State.IslandIndex % #Islands + 1
        TeleportIsland()
    end
end)

